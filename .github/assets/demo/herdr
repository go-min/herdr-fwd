#!/bin/sh
set -eu

if [ "$#" -eq 2 ] && [ "$1" = api ] && [ "$2" = snapshot ]; then
  cat <<'EOF'
{
  "workspaces": [
    {"workspace_id": "space-product", "label": "Product", "number": 1}
  ],
  "tabs": [
    {"tab_id": "tab-web", "label": "web", "number": 1}
  ],
  "panes": [
    {"pane_id": "pane-web", "workspace_id": "space-product", "tab_id": "tab-web"},
    {"pane_id": "pane-storybook", "workspace_id": "space-product", "tab_id": "tab-web"}
  ]
}
EOF
  exit 0
fi

[ -n "${HERDR_FWD_DEMO_REAL_HERDR:-}" ] || {
  printf 'README demo Herdr fixture requires HERDR_FWD_DEMO_REAL_HERDR\n' >&2
  exit 2
}
exec "$HERDR_FWD_DEMO_REAL_HERDR" "$@"
